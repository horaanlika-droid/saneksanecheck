# ============ ОБЯЗАТЕЛЬНО (всё, что нужно задать на хостинге) ============
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram user id администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=123456789

# Публичный https-адрес веб-приложения (появится после деплоя на хостинге).
# Нужен для кнопки «📷 Открыть портфолио» в меню бота.
# Можно задать позже и даже через самого бота: Админка → Профиль → Адрес веб-приложения
WEBAPP_URL=https://your-service.onrender.com

# ============ НЕОБЯЗАТЕЛЬНО ============
# Порт веб-сервера (большинство хостингов подставляют свой PORT сами)
PORT=8000
# Папка базы данных и загруженных фото
DATA_DIR=./data
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
